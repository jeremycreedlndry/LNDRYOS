{
  "expo": {
    "name": "LaundryPro",
    "slug": "laundry-pro",
    "version": "1.0.0",
    "orientation": "portrait",
    "scheme": "laundrypro",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.laundrypro.app"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#2563eb"
      },
      "package": "com.laundrypro.app"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store"
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
